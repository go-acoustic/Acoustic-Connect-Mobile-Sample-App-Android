<?xml version="1.0" encoding="utf-8"?>
<!-- bg_note with React Native's coloured left bar, in brand green, for the classpath note. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/light_grey" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:gravity="start" android:width="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_green" />
            <corners android:topLeftRadius="8dp" android:bottomLeftRadius="8dp" />
        </shape>
    </item>
</layer-list>
