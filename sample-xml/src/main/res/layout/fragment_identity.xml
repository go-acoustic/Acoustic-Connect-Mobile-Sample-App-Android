<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Demo.Screen">

    <LinearLayout style="@style/Demo.Column">

        <include layout="@layout/view_logo_header" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_last_result"
            style="@style/Demo.Card"
            android:visibility="gone">

            <LinearLayout style="@style/Demo.CardBody">

                <TextView
                    style="@style/Demo.Text.CardTitle"
                    android:text="@string/identity_last_result" />

                <TextView
                    android:id="@+id/tv_identity_status_message"
                    style="@style/Demo.Text.Body"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Demo.Card">

            <LinearLayout style="@style/Demo.CardBody">

                <TextView
                    android:id="@+id/tv_log_identity_title"
                    style="@style/Demo.Text.CardTitle"
                    android:text="@string/identity_log_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Demo.Text.Label"
                        android:text="@string/identity_name_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Demo.Field"
                        android:layout_marginTop="4dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_identifier_name"
                            style="@style/Demo.FieldInput"
                            android:hint="@string/identity_name_placeholder"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Demo.Text.Label"
                        android:text="@string/identity_value_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Demo.Field"
                        android:layout_marginTop="4dp">

                        <!-- Masked by id in ConnectLayoutConfig.json (IdentityFragment). -->
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_identifier_value"
                            style="@style/Demo.FieldInput"
                            android:hint="@string/identity_value_placeholder"
                            android:imeOptions="actionDone" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send_identity_signal"
                    style="@style/Demo.Button.Primary"
                    android:enabled="false"
                    android:text="@string/identity_log_logged_in" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send_account_registered_signal"
                    style="@style/Demo.Button.Primary"
                    android:enabled="false"
                    android:text="@string/identity_log_registered" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_history"
            style="@style/Demo.Card"
            android:visibility="gone">

            <LinearLayout style="@style/Demo.CardBody">

                <TextView
                    style="@style/Demo.Text.CardTitle"
                    android:text="@string/identity_recent" />

                <LinearLayout
                    android:id="@+id/ll_history_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
