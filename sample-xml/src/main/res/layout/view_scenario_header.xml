<?xml version="1.0" encoding="utf-8"?>
<!--
  React Native's ScenarioCard frame for one fix under verification: title, key and channel, the
  baseline-only banner, and the Do / Expect text. Included at the top of a card body, followed by
  that card's own controls; ScenarioCardBinder fills it from a Scenario.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView android:id="@+id/scenario_title" style="@style/Demo.Text.CardTitle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/scenario_key"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="@color/periwinkle"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scenario_channel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_grey"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/scenario_blocked"
        style="@style/Demo.NoteBox"
        android:background="@drawable/bg_note_accent"
        android:visibility="gone">

        <TextView
            android:id="@+id/scenario_blocked_title"
            style="@style/Demo.Text.Hint"
            android:textStyle="bold" />

        <TextView android:id="@+id/scenario_blocked_body" style="@style/Demo.Text.Hint" />
    </LinearLayout>

    <TextView style="@style/Demo.Text.ScenarioLabel" android:text="@string/scenario_do" />
    <TextView android:id="@+id/scenario_action" style="@style/Demo.Text.Body" />
    <TextView style="@style/Demo.Text.ScenarioLabel" android:text="@string/scenario_expect" />
    <TextView android:id="@+id/scenario_expected" style="@style/Demo.Text.Body" />

</merge>
