<?xml version="1.0" encoding="utf-8"?>
<!-- The replay modal's window content. ReplayModal sets the backdrop colour per variant. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/modal_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_modal_sheet"
        android:divider="@drawable/space_12"
        android:orientation="vertical"
        android:padding="20dp"
        android:showDividers="middle">

        <TextView
            style="@style/Demo.Text.CardTitle"
            android:text="@string/showcase_modal_content_title"
            android:textSize="17sp" />

        <TextView style="@style/Demo.Text.Body" android:text="@string/showcase_modal_content_body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView style="@style/Demo.Text.Label" android:text="@string/showcase_modal_note_label" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Demo.Field"
                android:layout_marginTop="4dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/field_replay_modal_note"
                    style="@style/Demo.FieldInput"
                    android:hint="@string/showcase_modal_note_placeholder" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_replay_modal_action"
            style="@style/Demo.Button.Primary"
            android:text="@string/showcase_modal_primary_action" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_replay_modal"
            style="@style/Demo.Button.Secondary"
            android:text="@string/showcase_modal_close" />

        <TextView
            android:id="@+id/txt_replay_modal_result"
            style="@style/Demo.Text.Hint" />
    </LinearLayout>
</FrameLayout>
