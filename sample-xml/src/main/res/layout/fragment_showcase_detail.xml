<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Demo.Screen">

    <LinearLayout style="@style/Demo.Column">

        <com.google.android.material.card.MaterialCardView style="@style/Demo.Card">
            <LinearLayout style="@style/Demo.CardBody">
                <TextView style="@style/Demo.Text.CardTitle" android:text="@string/detail_logged_title" />
                <TextView style="@style/Demo.Text.Body" android:text="@string/detail_logged_body" />
                <TextView android:id="@+id/detail_name" style="@style/Demo.Text.Mono" android:textSize="13sp" />
                <TextView style="@style/Demo.Text.Body" android:text="@string/detail_logged_referrer" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Demo.Card">
            <LinearLayout style="@style/Demo.CardBody">
                <TextView style="@style/Demo.Text.CardTitle" android:text="@string/detail_chain_title" />
                <TextView android:id="@+id/detail_depth" style="@style/Demo.Text.Body" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_showcase_push_detail"
                    style="@style/Demo.Button.Primary"
                    android:text="@string/detail_push_another" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_showcase_back"
                    style="@style/Demo.Button.Secondary"
                    android:text="@string/detail_back" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
