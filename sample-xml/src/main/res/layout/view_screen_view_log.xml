<?xml version="1.0" encoding="utf-8"?>
<!--
  The exact-name card's log, newest first. Only the newest line carries the contract id, as in
  React Native; the older lines share one text view below it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_views_log"
    style="@style/Demo.NoteBox"
    android:visibility="gone">

    <TextView android:id="@+id/txt_screenview_result" style="@style/Demo.Text.Mono" />

    <TextView
        android:id="@+id/txt_screenview_history"
        style="@style/Demo.Text.Mono"
        android:visibility="gone" />
</LinearLayout>
